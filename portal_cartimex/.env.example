# Copie este archivo como .env y complete los valores. NUNCA suba .env a git.
CARTIMEX_API_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Clave para entrar al portal (pedida: 12345). Cámbiela por una larga antes de exponerlo a Internet.
PORTAL_PASSWORD=12345
# Genere uno con: python3 -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_HOURS=12
# 1 cuando el portal se sirva por HTTPS (con Caddy)
COOKIE_SECURE=1
# Dominio para Caddy (HTTPS automático), ej. compras.tecnosmart.com.ec
PORTAL_DOMAIN=compras.example.com
